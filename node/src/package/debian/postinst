${{header}}

app_name=${{app_name}}
default_instance=mainnet
config_dir="/etc/$app_name/$default_instance"
config_file="$config_dir/hearth.conf"

# Every instance the operator has configured, enabled or not
instance_units() {
    {
        systemctl list-units --all --no-legend --no-pager --plain "$app_name@*.service" 2>/dev/null || true
        systemctl list-unit-files --no-legend --no-pager --plain "$app_name@*.service" 2>/dev/null || true
    } | awk '{print $1}' | sort -u
}

if [ "$1" = configure ]; then
    chown -R "$app_name:$app_name" "/usr/share/$app_name"

    if [ ! -f "$config_file" ]; then
        echo "Creating default config file $config_file ..."
        mkdir -p "$config_dir"
        chmod 750 "$config_dir"
        chown "root:$app_name" "$config_dir"
        cp "/usr/share/$app_name/doc/hearth.conf.sample" "$config_file"
        chmod 640 "$config_file"
        chown "root:$app_name" "$config_file"
    fi

    if command -v systemctl > /dev/null; then
        systemctl daemon-reload || true

        if [ -z "$2" ]; then
            # Fresh install: one mainnet instance, more are added with `systemctl enable $app_name@<name>`
            echo "Enabling $app_name@$default_instance ..."
            systemctl enable "$app_name@$default_instance.service" || true
            if [ -d /run/systemd/system ]; then
                systemctl start "$app_name@$default_instance.service" || true
            fi
        else
            for unit in $(instance_units); do
                systemctl try-restart "$unit" || true
            done
        fi
    fi
fi

exit 0
